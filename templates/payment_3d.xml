<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         3D Secure Redirect Page
         Shows a loading spinner while redirecting the customer to
         the bank's 3D Secure verification page.
         ============================================================ -->
    <template id="payment_3d_redirect" name="3D Secure Redirect">
        <t t-call="web.layout">
            <t t-set="head">
                <style>
                    body {
                        background-color: #f8f9fa;
                    }
                    .tp-3d-container {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        padding: 2rem;
                    }
                    .tp-3d-card {
                        background: #fff;
                        border-radius: 12px;
                        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
                        padding: 3rem;
                        max-width: 480px;
                        width: 100%;
                        text-align: center;
                    }
                    .tp-spinner {
                        width: 64px;
                        height: 64px;
                        border: 4px solid #e9ecef;
                        border-top: 4px solid #0d6efd;
                        border-radius: 50%;
                        animation: tp-spin 1s linear infinite;
                        margin: 0 auto 1.5rem;
                    }
                    @keyframes tp-spin {
                        0% { transform: rotate(0deg); }
                        100% { transform: rotate(360deg); }
                    }
                    .tp-3d-title {
                        font-size: 1.25rem;
                        font-weight: 600;
                        color: #212529;
                        margin-bottom: 0.75rem;
                    }
                    .tp-3d-text {
                        color: #6c757d;
                        font-size: 0.95rem;
                        line-height: 1.5;
                    }
                    .tp-bank-logo {
                        max-width: 120px;
                        max-height: 48px;
                        margin-bottom: 1.5rem;
                    }
                    .tp-secure-badge {
                        display: inline-flex;
                        align-items: center;
                        gap: 0.5rem;
                        background: #e8f5e9;
                        color: #2e7d32;
                        padding: 0.5rem 1rem;
                        border-radius: 20px;
                        font-size: 0.85rem;
                        margin-top: 1.5rem;
                    }
                </style>
            </t>
            <t t-set="body">
                <div class="tp-3d-container">
                    <div class="tp-3d-card">
                        <div class="tp-spinner"/>
                        <h2 class="tp-3d-title">3D Secure Dogrulama</h2>
                        <p class="tp-3d-text">
                            Odemeniz icin banka dogrulama sayfasina yonlendiriliyorsunuz.
                            Lutfen bekleyiniz...
                        </p>
                        <p class="tp-3d-text">
                            <small>Bu islem birka&#231; saniye surebilir.</small>
                        </p>
                        <div class="tp-secure-badge">
                            <i class="fa fa-lock"/>
                            <span>SSL ile korunmaktadir</span>
                        </div>
                    </div>
                </div>

                <!-- Hidden form for 3D Secure redirect -->
                <t t-if="redirect_url">
                    <form id="tp_3d_form" method="post" t-att-action="redirect_url">
                        <t t-if="redirect_params">
                            <t t-foreach="redirect_params" t-as="param">
                                <input type="hidden"
                                       t-att-name="param"
                                       t-att-value="redirect_params[param]"/>
                            </t>
                        </t>
                    </form>
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            setTimeout(function() {
                                document.getElementById('tp_3d_form').submit();
                            }, 1500);
                        });
                    </script>
                </t>

                <!-- HTML content for direct 3D Secure (some gateways return HTML) -->
                <t t-if="redirect_html">
                    <div id="tp_3d_html_container" style="display:none;">
                        <t t-out="redirect_html"/>
                    </div>
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            setTimeout(function() {
                                var container = document.getElementById('tp_3d_html_container');
                                if (container) {
                                    container.style.display = 'block';
                                    var forms = container.getElementsByTagName('form');
                                    if (forms.length > 0) {
                                        forms[0].submit();
                                    }
                                }
                            }, 1500);
                        });
                    </script>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================================
         Payment Error Page
         Displayed when a payment fails or encounters an error.
         Shows the error message and provides a retry option.
         ============================================================ -->
    <template id="payment_error" name="Payment Error">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card border-danger shadow-sm">
                            <div class="card-body text-center p-5">
                                <div class="mb-4">
                                    <span class="fa-stack fa-3x text-danger">
                                        <i class="fa fa-circle fa-stack-2x"/>
                                        <i class="fa fa-times fa-stack-1x fa-inverse"/>
                                    </span>
                                </div>
                                <h3 class="card-title text-danger mb-3">Odeme Basarisiz</h3>
                                <p class="card-text text-muted mb-2">
                                    Odeme isleminiz sirasinda bir hata olustu.
                                </p>
                                <t t-if="error_message">
                                    <div class="alert alert-danger mt-3" role="alert">
                                        <i class="fa fa-exclamation-triangle me-2"/>
                                        <t t-out="error_message"/>
                                    </div>
                                </t>
                                <t t-if="error_code">
                                    <p class="text-muted small">
                                        Hata Kodu: <code t-out="error_code"/>
                                    </p>
                                </t>
                                <hr class="my-4"/>
                                <div class="d-grid gap-2">
                                    <a href="/shop/payment" class="btn btn-primary btn-lg">
                                        <i class="fa fa-refresh me-2"/>
                                        Tekrar Deneyin
                                    </a>
                                    <a href="/shop/cart" class="btn btn-outline-secondary">
                                        <i class="fa fa-shopping-cart me-2"/>
                                        Sepete Don
                                    </a>
                                    <a href="/contactus" class="btn btn-link text-muted">
                                        <i class="fa fa-headphones me-2"/>
                                        Destek
                                    </a>
                                </div>
                            </div>
                        </div>
                        <p class="text-center text-muted mt-3 small">
                            <i class="fa fa-lock me-1"/>
                            Tum odemeleriniz SSL ile korunmaktadir.
                        </p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================
         Payment Success Page
         Displayed after successful payment completion.
         Shows order confirmation and next steps.
         ============================================================ -->
    <template id="payment_success" name="Payment Success">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card border-success shadow-sm">
                            <div class="card-body text-center p-5">
                                <div class="mb-4">
                                    <span class="fa-stack fa-3x text-success">
                                        <i class="fa fa-circle fa-stack-2x"/>
                                        <i class="fa fa-check fa-stack-1x fa-inverse"/>
                                    </span>
                                </div>
                                <h3 class="card-title text-success mb-3">Odeme Basarili!</h3>
                                <p class="card-text text-muted mb-2">
                                    Odemeniz basariyla tamamlandi. Tesekkur ederiz.
                                </p>
                                <t t-if="transaction_ref">
                                    <div class="alert alert-success mt-3" role="alert">
                                        <small class="text-muted">Islem Referansi</small>
                                        <br/>
                                        <strong t-out="transaction_ref"/>
                                    </div>
                                </t>
                                <t t-if="installment_count and installment_count &gt; 1">
                                    <div class="card bg-light mt-3">
                                        <div class="card-body py-2">
                                            <div class="row text-start small">
                                                <div class="col-6 text-muted">Taksit Sayisi:</div>
                                                <div class="col-6 fw-bold">
                                                    <t t-out="installment_count"/> Taksit
                                                </div>
                                                <div class="col-6 text-muted">Aylik Tutar:</div>
                                                <div class="col-6 fw-bold">
                                                    <t t-out="installment_amount"
                                                       t-options="{'widget': 'monetary', 'display_currency': currency_id}"/>
                                                </div>
                                                <div class="col-6 text-muted">Toplam Tutar:</div>
                                                <div class="col-6 fw-bold">
                                                    <t t-out="total_amount"
                                                       t-options="{'widget': 'monetary', 'display_currency': currency_id}"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <hr class="my-4"/>
                                <div class="d-grid gap-2">
                                    <a href="/my/orders" class="btn btn-success btn-lg">
                                        <i class="fa fa-list me-2"/>
                                        Siparislerimi Gor
                                    </a>
                                    <a href="/shop" class="btn btn-outline-primary">
                                        <i class="fa fa-shopping-bag me-2"/>
                                        Alisverise Devam Et
                                    </a>
                                </div>
                            </div>
                        </div>
                        <p class="text-center text-muted mt-3 small">
                            <i class="fa fa-envelope me-1"/>
                            Siparis onayiniz e-posta adresinize gonderilmistir.
                        </p>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
