<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Bank (Banka) Views                                            -->
    <!-- ============================================================ -->

    <!-- Tree / List View -->
    <record id="turkish_pos_bank_view_list" model="ir.ui.view">
        <field name="name">turkish.pos.bank.list</field>
        <field name="model">turkish.pos.bank</field>
        <field name="arch" type="xml">
            <list string="Bankalar">
                <field name="sequence" widget="handle"/>
                <field name="logo" widget="image" string="" options="{'size': [32, 32]}"/>
                <field name="name" string="Adi"/>
                <field name="code" string="Banka Tanimlayici Kod"/>
                <field name="country" string="Ulke"/>
                <field name="is_default" string="Varsayilan" widget="boolean_toggle"/>
                <field name="active" string="Etkin" widget="boolean_toggle"/>
                <field name="card_brands" string="Markalar"/>
                <field name="gateway_ids"
                       string="Saglayici"
                       widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="turkish_pos_bank_view_form" model="ir.ui.view">
        <field name="name">turkish.pos.bank.form</field>
        <field name="model">turkish.pos.bank</field>
        <field name="arch" type="xml">
            <form string="Banka">
                <sheet>
                    <field name="logo"
                           widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'logo'}"/>
                    <div class="oe_title">
                        <label for="name" string="Banka Adi"/>
                        <h1>
                            <field name="name" placeholder="Banka adi giriniz..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Genel Bilgiler">
                            <field name="code" string="Banka Tanimlayici Kod"/>
                            <field name="swift_code" string="SWIFT Kodu"/>
                            <field name="country" string="Ulke"/>
                            <field name="card_brands" string="Markalar"/>
                            <field name="sequence" string="Sira"/>
                        </group>
                        <group string="Entegrasyon">
                            <field name="is_default" string="Varsayilan Banka"/>
                            <field name="active" string="Etkin"/>
                            <field name="gateway_ids"
                                   string="Saglayicilar"
                                   widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Taksit Yapilandirmasi" name="installment_config">
                            <field name="installment_config_ids" string="Taksit Ayarlari">
                                <list editable="bottom">
                                    <field name="installment_count" string="Taksit Sayisi"/>
                                    <field name="interest_rate" string="Faiz Orani (%)"/>
                                    <field name="commission_rate" string="Komisyon Orani (%)"/>
                                    <field name="min_amount" string="Minimum Tutar"/>
                                    <field name="campaign_active" string="Kampanya Aktif"/>
                                    <field name="active" string="Aktif"/>
                                </list>
                            </field>
                        </page>
                        <page string="Kategori Kisitlamalari" name="category_restrictions">
                            <field name="category_restriction_ids" string="Kisitlamalar">
                                <list editable="bottom">
                                    <field name="category_id" string="Kategori"/>
                                    <field name="max_installment" string="Maks. Taksit"/>
                                    <field name="min_installment" string="Min. Taksit"/>
                                    <field name="installment_allowed" string="Taksit Izni"/>
                                    <field name="blocked_installments" string="Engellenen Taksitler"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="turkish_pos_bank_action" model="ir.actions.act_window">
        <field name="name">Bankalar</field>
        <field name="res_model">turkish.pos.bank</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Yeni bir banka ekleyin
            </p>
            <p>
                Sanal POS entegrasyonunda kullanilacak bankalari
                buradan yonetebilirsiniz.
            </p>
        </field>
    </record>

</odoo>
