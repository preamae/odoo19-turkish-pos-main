<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Extends: product.template form – Installment settings         -->
    <!-- ============================================================ -->
    <record id="product_template_form_turkish_pos" model="ir.ui.view">
        <field name="name">product.template.form.turkish.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="Taksit Ayarlari" name="turkish_pos_installment">
                    <group string="Sanal POS Taksit Ayarlari">
                        <group>
                            <field name="installment_allowed"
                                   string="Taksit Izni"/>
                            <field name="max_installment"
                                   string="Maksimum Taksit Sayisi"
                                   invisible="not installment_allowed"/>
                        </group>
                        <group>
                            <field name="min_installment_amount"
                                   string="Minimum Taksit Tutari"
                                   invisible="not installment_allowed"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
