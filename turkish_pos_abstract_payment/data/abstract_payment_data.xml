<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dummy Payment Gateway -->
        <record id="gateway_dummy" model="payment.gateway">
            <field name="name">Dummy Gateway (Test)</field>
            <field name="code">dummy_gateway</field>
            <field name="active" eval="True"/>
            <field name="sequence">10</field>
            <field name="environment">test</field>
            <field name="gateway_type">redirect</field>
            <field name="supports_3d_secure" eval="True"/>
            <field name="supports_installments" eval="True"/>
            <field name="supports_refunds" eval="True"/>
            <field name="timeout">30</field>
            <field name="retry_count">3</field>
            <field name="credentials">{
  "api_key": "test_api_key_12345",
  "merchant_id": "test_merchant_001",
  "secret_key": "test_secret_xyz",
  "terminal_id": "VP000001"
}</field>
            <field name="payment_url">https://test-gateway.example.com/payment</field>
            <field name="callback_url">/payment/abstract/3d_return</field>
        </record>

        <!-- Cash Payment Method -->
        <record id="payment_method_cash" model="payment.method">
            <field name="name">Nakit Ödeme</field>
            <field name="code">cash</field>
            <field name="payment_type">cash</field>
            <field name="sequence">10</field>
            <field name="description">Nakit ödeme yöntemi - Teslimat sırasında nakit ödeme yapabilirsiniz.</field>
            <field name="active" eval="True"/>
            <field name="supports_installments" eval="False"/>
            <field name="requires_3d_secure" eval="False"/>
            <field name="show_on_checkout" eval="True"/>
            <field name="turkish_pos_enabled" eval="False"/>
            <field name="min_amount">0.0</field>
            <field name="max_amount">10000.0</field>
            <field name="auto_capture" eval="True"/>
            <field name="allow_refund" eval="True"/>
            <field name="refund_policy">full</field>
        </record>

        <!-- Credit Card Payment Method -->
        <record id="payment_method_credit_card" model="payment.method">
            <field name="name">Kredi Kartı</field>
            <field name="code">credit_card</field>
            <field name="payment_type">card</field>
            <field name="sequence">20</field>
            <field name="description">Kredi kartı ile ödeme - Tüm banka kartları kabul edilir. Taksit seçenekleri mevcuttur.</field>
            <field name="active" eval="True"/>
            <field name="supports_installments" eval="True"/>
            <field name="requires_3d_secure" eval="True"/>
            <field name="show_on_checkout" eval="True"/>
            <field name="turkish_pos_enabled" eval="True"/>
            <field name="min_amount">10.0</field>
            <field name="max_amount">0.0</field>
            <field name="max_installments">12</field>
            <field name="min_installment_amount">100.0</field>
            <field name="auto_capture" eval="True"/>
            <field name="allow_refund" eval="True"/>
            <field name="refund_policy">partial</field>
            <field name="gateway_id" ref="gateway_dummy"/>
        </record>

        <!-- Bank Transfer Payment Method -->
        <record id="payment_method_bank_transfer" model="payment.method">
            <field name="name">Banka Havalesi / EFT</field>
            <field name="code">bank_transfer</field>
            <field name="payment_type">bank_transfer</field>
            <field name="sequence">30</field>
            <field name="description">Banka havalesi veya EFT ile ödeme yapabilirsiniz. Ödeme onaylandıktan sonra siparişiniz işleme alınacaktır.</field>
            <field name="active" eval="True"/>
            <field name="supports_installments" eval="False"/>
            <field name="requires_3d_secure" eval="False"/>
            <field name="show_on_checkout" eval="True"/>
            <field name="turkish_pos_enabled" eval="False"/>
            <field name="min_amount">100.0</field>
            <field name="max_amount">0.0</field>
            <field name="auto_capture" eval="False"/>
            <field name="allow_refund" eval="True"/>
            <field name="refund_policy">full</field>
        </record>

        <!-- Add supported currencies to payment methods -->
        <function model="payment.method" name="write">
            <value model="payment.method" search="[('code', 'in', ['cash', 'credit_card', 'bank_transfer'])]"/>
            <value eval="{'supported_currency_ids': [(6, 0, [
                ref('base.TRY'),
                ref('base.USD'),
                ref('base.EUR')
            ])]}"/>
        </function>
    </data>
</odoo>
