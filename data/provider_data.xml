<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             Default Payment Provider for Turkish Virtual POS
             Creates the payment.provider record that integrates with
             Odoo's payment framework. Linked to the main Turkish banks
             for installment processing.
             ============================================================ -->

        <record id="payment_provider_turkish_pos" model="payment.provider">
            <field name="name">Kredi Karti (Taksitli)</field>
            <field name="code">turkish_pos</field>
            <field name="state">test</field>
            <field name="is_published">True</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="turkish_pos_show_installments" eval="True"/>
            <field name="turkish_pos_default_installment">1</field>
            <field name="turkish_pos_max_installment">12</field>
            <field name="turkish_pos_min_installment_amount">100.0</field>
            <field name="turkish_pos_bank_ids" eval="[
                (4, ref('bank_akbank')),
                (4, ref('bank_garanti')),
                (4, ref('bank_yapikredi')),
                (4, ref('bank_isbank')),
                (4, ref('bank_ziraat')),
                (4, ref('bank_qnb_finans')),
                (4, ref('bank_halkbank')),
                (4, ref('bank_denizbank')),
                (4, ref('bank_hsbc')),
                (4, ref('bank_teb')),
                (4, ref('bank_ing')),
                (4, ref('bank_vakifbank')),
                (4, ref('bank_finansbank')),
                (4, ref('bank_sekerbank')),
            ]"/>
        </record>

    </data>
</odoo>
