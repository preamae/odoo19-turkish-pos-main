        <!-- Ziraat Bankasi -->
        <record id="bank_ziraat" model="turkish.pos.bank">
            <field name="name">Turkiye Cumhuriyeti Ziraat Bankasi A.S.</field>
            <field name="code">TCZBTR2A</field>
            <field name="country">Turkiye</field>
            <field name="card_brands">Bankart</field>
            <field name="active">True</field>
            <field name="gateway_ids" eval="[
                (4, ref('gateway_estv3_pos')),
                (4, ref('gateway_param')),
                (4, ref('gateway_tosla')),
                (4, ref('gateway_iyzico')),
            ]"/>
        </record>

