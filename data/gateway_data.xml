<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Payment Gateway Seed Data
             Defines all supported Turkish payment gateway integrations.
             Gateways marked supports_all_banks=True work as aggregators
             that can process payments for any bank's cards.
             ============================================================ -->

        <!-- Param (Turk Elektronik Para) - Aggregator -->
        <record id="gateway_param" model="turkish.pos.gateway">
            <field name="name">Param</field>
            <field name="code">param</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
            <field name="supports_all_banks" eval="True"/>
            <field name="payment_model">3d_secure</field>
            <field name="environment">test</field>
            <field name="credentials">{
    "clientCode": "10738",
    "username": "Test",
    "password": "Test",
    "guid": "0c13d406-873b-403b-9c09-a5766840d98c",
    "test_endpoint": "https://test-dmz.param.com.tr/turkpos.ws/service_turkpos_prod.asmx",
    "prod_endpoint": "https://dmz.param.com.tr/turkpos.ws/service_turkpos_prod.asmx"
}</field>
            <field name="description">Param (Turk Elektronik Para) - Tum bankalari destekleyen odeme gecidi.</field>
        </record>

