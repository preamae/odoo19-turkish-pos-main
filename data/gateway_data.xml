    "test_endpoint": "https://preprod.tosla.com/api/Payment",
    "prod_endpoint": "https://tosla.com/api/Payment"
}</field>
            <field name="description">Tosla (Akbank Fintek) - Tum bankalari destekleyen odeme gecidi.</field>
        </record>

